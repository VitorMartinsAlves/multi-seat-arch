# This file documents the runtime rule generated by multi-seat-arch.
# The actual rules are written to /run/udev/rules.d/73-multi-seat-arch-virtual-seat.rules.
# Example:
# SUBSYSTEM=="input", KERNEL=="input*", ATTR{phys}=="multi-seat-arch/seat-card1-HDMI-A-1", ENV{ID_SEAT}="seat-card1-HDMI-A-1", TAG+="seat", TAG+="master-of-seat"
